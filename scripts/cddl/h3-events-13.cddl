; CDDL extracted verbatim from the published draft-ietf-quic-qlog-h3-events-13
; (every <sourcecode type="cddl"> block of https://www.ietf.org/archive/id/draft-ietf-quic-qlog-h3-events-13.xml,
;  each cross-checked against the published .txt).
; Generated by scripts/cddl/extract-cddl.mjs -- do not edit by hand.

; ---- #h3-events-def: HTTP3EventData definition and ProtocolEventData extension
HTTP3EventData = HTTP3ParametersSet /
              HTTP3ParametersRestored /
              HTTP3StreamTypeSet /
              HTTP3PriorityUpdated /
              HTTP3FrameCreated /
              HTTP3FrameParsed /
              HTTP3DatagramCreated /
              HTTP3DatagramParsed /
              HTTP3PushResolved

$ProtocolEventData /= HTTP3EventData

; ---- #h3-parametersset-def: HTTP3ParametersSet definition
HTTP3ParametersSet = {
    ? initiator: Initiator

    ; RFC9114
    ? max_field_section_size: uint64

    ; RFC9204
    ? max_table_capacity: uint64
    ? blocked_streams_count: uint64

    ; RFC9220 (SETTINGS_ENABLE_CONNECT_PROTOCOL)
    ? extended_connect: uint16

    ; RFC9297 (SETTINGS_H3_DATAGRAM)
    ? h3_datagram: uint16

    ; qlog-specific
    ; indicates whether this implementation waits for a SETTINGS
    ; frame before processing requests
    ? waits_for_settings: bool

    * $$http3-parametersset-extension
}

; ---- #h3-parametersrestored-def: HTTP3ParametersRestored definition
HTTP3ParametersRestored = {
    ; RFC9114
    ? max_field_section_size: uint64

    ; RFC9204
    ? max_table_capacity: uint64
    ? blocked_streams_count: uint64

    ; RFC9220 (SETTINGS_ENABLE_CONNECT_PROTOCOL)
    ? extended_connect: uint16

    ; RFC9297 (SETTINGS_H3_DATAGRAM)
    ? h3_datagram: uint16

    * $$http3-parametersrestored-extension
}

; ---- #h3-streamtypeset-def: HTTP3StreamTypeSet definition
HTTP3StreamTypeSet = {
    ? initiator: Initiator
    stream_id: uint64
    stream_type: $HTTP3StreamType

    ; only when stream_type === "unknown"
    ? stream_type_bytes: uint64

    ; only when stream_type === "push"
    ? associated_push_id: uint64

    * $$http3-streamtypeset-extension
}

$HTTP3StreamType /=   "request" /
                      "control" /
                      "push" /
                      "reserved" /
                      "unknown" /
                      "qpack_encode" /
                      "qpack_decode"

; ---- #h3-priorityupdated-def: HTTP3PriorityUpdated definition
HTTP3PriorityUpdated = {
    ; if the prioritized element is a request stream
    ? stream_id: uint64

    ; if the prioritized element is a push stream
    ? push_id: uint64

    ? old: HTTP3Priority
    new: HTTP3Priority

    ? trigger: "client_signal_received" /
                "local" /
                "other"

    ? reason: "client_signal_only" /
               "client_server_merged" /
               "local_policy" /
               "other"

    * $$http3-priorityupdated-extension
}

; ---- #h3-framecreated-def: HTTP3FrameCreated definition
HTTP3FrameCreated = {
    stream_id: uint64
    frame: $HTTP3Frame

    * $$http3-framecreated-extension
}

; ---- #h3-frameparsed-def: HTTP3FrameParsed definition
HTTP3FrameParsed = {
    stream_id: uint64
    frame: $HTTP3Frame

    * $$http3-frameparsed-extension
}

; ---- #h3-datagramcreated-def: HTTP3DatagramCreated definition
HTTP3DatagramCreated = {
    quarter_stream_id: uint64
    ? raw: RawInfo

    * $$http3-datagramcreated-extension
}

; ---- #h3-datagramparsed-def: HTTP3DatagramParsed definition
HTTP3DatagramParsed = {
    quarter_stream_id: uint64
    ? raw: RawInfo

    * $$http3-datagramparsed-extension
}

; ---- #h3-pushresolved-def: HTTP3PushResolved definition
HTTP3PushResolved = {
    ? push_id: uint64

    ; in case this is logged from a place that does not have access
    ; to the push_id
    ? stream_id: uint64
    decision: HTTP3PushDecision

    * $$http3-pushresolved-extension
}

HTTP3PushDecision = "claimed" /
                 "abandoned"

; ---- #initiator-def: Initiator definition
Initiator = "local" /
            "remote"

; ---- #h3baseframe-def: HTTP3BaseFrames definition
HTTP3BaseFrames = HTTP3DataFrame /
                  HTTP3HeadersFrame /
                  HTTP3CancelPushFrame /
                  HTTP3SettingsFrame /
                  HTTP3PushPromiseFrame /
                  HTTP3GoawayFrame /
                  HTTP3MaxPushIDFrame /
                  HTTP3ReservedFrame /
                  HTTP3UnknownFrame

HTTP3ExtensionFrames = HTTP3PriorityUpdateFrame /
                       HTTP3OriginFrame

$HTTP3Frame /= HTTP3BaseFrames / HTTP3ExtensionFrames

; ---- #h3dataframe-def: HTTP3DataFrame definition
HTTP3DataFrame = {
    frame_type: "data"
    ? raw: RawInfo
}

; ---- #h3field-def: HTTP3HTTPField definition
HTTP3HTTPField = {
    ? name: text
    ? name_bytes: hexstring
    ? value: text
    ? value_bytes: hexstring
}

; ---- #h3-headersframe-def: HTTP3HeadersFrame definition
HTTP3HeadersFrame = {
    frame_type: "headers"
    headers: [* HTTP3HTTPField]
    ? raw: RawInfo
}

; ---- #h3-cancelpushframe-def: HTTP3CancelPushFrame definition
HTTP3CancelPushFrame = {
    frame_type: "cancel_push"
    push_id: uint64
    ? raw: RawInfo
}

; ---- #h3settingsframe-def: HTTP3SettingsFrame definition
HTTP3SettingsFrame = {
    frame_type: "settings"
    settings: [* HTTP3Setting]
    ? raw: RawInfo
}

HTTP3Setting = {
    ? name: $HTTP3SettingsName
    ; only when name === "unknown"
    ? name_bytes: uint64

    value: uint64
}

$HTTP3SettingsName /= "settings_qpack_max_table_capacity" /
                   "settings_max_field_section_size" /
                   "settings_qpack_blocked_streams" /
                   "settings_enable_connect_protocol" /
                   "settings_h3_datagram" /
                   "reserved" /
                   "unknown"

; ---- #h3pushpromiseframe-def: HTTP3PushPromiseFrame definition
HTTP3PushPromiseFrame = {
    frame_type: "push_promise"
    push_id: uint64
    headers: [* HTTP3HTTPField]
    ? raw: RawInfo
}

; ---- #h3goawayframe-def: HTTP3GoawayFrame definition
HTTP3GoawayFrame = {
    frame_type: "goaway"

    ; Either stream_id or push_id.
    ; This is implicit from the sender of the frame
    id: uint64
    ? raw: RawInfo
}

; ---- #h3maxpushidframe-def: HTTP3MaxPushIDFrame definition
HTTP3MaxPushIDFrame = {
    frame_type: "max_push_id"
    push_id: uint64
    ? raw: RawInfo
}

; ---- #h3reservedframe-def: HTTP3ReservedFrame definition
HTTP3ReservedFrame = {
    frame_type: "reserved"
    frame_type_bytes: uint64
    ? raw: RawInfo
}

; ---- #h3unknownframe-def: HTTP3UnknownFrame definition
HTTP3UnknownFrame = {
    frame_type: "unknown"
    frame_type_bytes: uint64
    ? raw: RawInfo
}

; ---- #h3priorityupdateframe-def: HTTP3PriorityUpdateFrame definition
HTTP3PriorityUpdateFrame = {
    frame_type: "priority_update"

    ; if the prioritized element is a request stream
    ? stream_id: uint64

    ; if the prioritized element is a push stream
    ? push_id: uint64

    priority_field_value: HTTP3Priority
    ? raw: RawInfo
}

; The priority value in ASCII text, encoded using Structured Fields
; Example: u=5, i
HTTP3Priority = text

; ---- #h3originframe-def: HTTP3OriginFrame definition
HTTP3OriginEntry = {
  origin_len: uint16
  ? ascii_origin: text
}

HTTP3OriginFrame = {
  frame_type: "origin"

  origin_entries: [* HTTP3OriginEntry]
}

; ---- #h3-applicationerror-def: HTTP3ApplicationError definition
HTTP3ApplicationError = "http_no_error" /
                       "http_general_protocol_error" /
                       "http_internal_error" /
                       "http_stream_creation_error" /
                       "http_closed_critical_stream" /
                       "http_frame_unexpected" /
                       "http_frame_error" /
                       "http_excessive_load" /
                       "http_id_error" /
                       "http_settings_error" /
                       "http_missing_settings" /
                       "http_request_rejected" /
                       "http_request_cancelled" /
                       "http_request_incomplete" /
                       "http_early_response" /
                       "http_connect_error" /
                       "http_version_fallback"

; ---- (no figure, xml line 833)
; ensure HTTP errors are properly validated in QUIC events as well
; e.g., QUIC's ConnectionClose Frame
$ApplicationError /= HTTP3ApplicationError

; ---- #http-events-def: HTTPEventData definition and ProtocolEventData extension
HTTPEventData = HTTPCapsuleCreated /
                HTTPCapsuleParsed

$ProtocolEventData /= HTTPEventData

; ---- #http-capsulecreated-def: HTTPCapsuleCreated definition
HTTPCapsuleCreated = {
    stream_id: uint64

    capsule: $HTTPCapsule

    * $$http-capsulecreated-extension
}

; ---- #http-capsuleparsed-def: HTTPCapsuleParsed definition
HTTPCapsuleParsed = {
    stream_id: uint64

    capsule: $HTTPCapsule

    * $$http-capsuleparsed-extension
}

; ---- #httpbasecapsule-def: HTTPBaseCapsules definition
HTTPBaseCapsules = HTTPCapsuleDatagram /
                   HTTPCapsuleUnknown

$HTTPCapsule /= HTTPBaseCapsules

; ---- #httpcapsuledatagram-def: HTTPCapsuleDatagram definition
HTTPCapsuleDatagram = {
    capsule_type: "datagram"
    ? raw: RawInfo
}

; ---- #httpcapsuleunknown-def: HTTPCapsuleUnknown definition
HTTPCapsuleUnknown = {
    capsule_type: "unknown"

    ? capsule_type_value: uint64
    ? raw: RawInfo
}
