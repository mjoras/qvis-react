; CDDL extracted verbatim from the published draft-ietf-quic-qlog-main-schema-14
; (every <sourcecode type="cddl"> block of https://www.ietf.org/archive/id/draft-ietf-quic-qlog-main-schema-14.xml,
;  each cross-checked against the published .txt).
; Generated by scripts/cddl/extract-cddl.mjs -- do not edit by hand.

; ---- #cddl-custom-types-def: Additional CDDL type definitions
; CDDL's uint is defined as being 64-bit in size
; but for many protocol fields it is better to be restrictive
; and explicit
uint8 = uint .size 1
uint16 = uint .size 2
uint32 = uint .size 4
uint64 = uint .size 8

; an even-length lowercase string of hexadecimally encoded bytes
; examples: 82dc, 027339, 4cdbfd9bf0
; this is needed because the default CDDL binary string (bytes/bstr)
; is only CBOR and not JSON compatible
hexstring = text .regexp "([0-9a-f]{2})*"

; ---- #abstract-logfile-def: LogFile definition
LogFile = {
    file_schema: text
    serialization_format: text
    ? title: text
    ? description: text
}

; ---- #qlog-file-def: QlogFile definition
QlogFile = {
    ~LogFile
    ? traces: [+ Trace /
                TraceError]
}

; ---- #trace-def: Trace definition
Trace = {
    ? title: text
    ? description: text
    ? common_fields: CommonFields
    ? vantage_point: VantagePoint
    event_schemas: [+text]
    events: [* Event]
}

; ---- #trace-error-def: TraceError definition
TraceError = {
    error_description: text

    ; the original URI used for attempted find of the file
    ? uri: text
    ? vantage_point: VantagePoint
}

; ---- #qlog-file-seq-def: QlogFileSeq definition
QlogFileSeq = {
    ~LogFile
    trace: TraceSeq
}

; ---- #trace-seq-def: TraceSeq definition
TraceSeq = {
    ? title: text
    ? description: text
    ? common_fields: CommonFields
    ? vantage_point: VantagePoint
    event_schemas: [+text]
}

; ---- #vantage-point-def: VantagePoint definition
VantagePoint = {
    ? name: text
    type: VantagePointType
    ? flow: VantagePointFlow
}

; client = endpoint which initiates the connection
; server = endpoint which accepts the connection
; network = observer in between client and server
VantagePointType = "client" /
                   "server" /
                   "network" /
                   "unknown"

; client = vantage point follows client data flow semantics
;          (a "packet sent" event goes towards the server)
; server = vantage point follows server data flow semantics
;          (a "packet sent" event goes towards the client)
; unknown = the flow's direction is unknown
VantagePointFlow = "client" /
                   "server" /
                   "unknown"

; ---- #event-def: Event definition
Event = {
    time: float64
    name: text
    data: $ProtocolEventData
    ? tuple: TupleID
    ? time_format: TimeFormat
    ? group_id: GroupID
    ? system_info: SystemInformation

    ; events can contain any amount of custom fields
    * text => any
}

; ---- #reference-time-def: ReferenceTime definition
ReferenceTime = {
    clock_type: "system" / "monotonic" / text .default "system"
    epoch: RFC3339DateTime / "unknown"

    ? wall_clock_time: RFC3339DateTime
}

RFC3339DateTime = text .default "1970-01-01T00:00:00.000Z"

; ---- #time-format-def: TimeFormat definition
TimeFormat = "relative_to_epoch" /
             "relative_to_previous_event" .default "relative_to_epoch"

; ---- #tuple-def: TupleID definition
TupleID = text .default ""

; ---- #group-id-def: GroupID definition
GroupID = text

; ---- (no figure, xml line 919)
SystemInformation = {
  ? processor_id: uint32
  ? process_id: uint32
  ? thread_id: uint32
}

; ---- #common-fields-def: CommonFields definition
CommonFields = {
    ? tuple: TupleID
    ? time_format: TimeFormat
    ? reference_time: ReferenceTime
    ? group_id: GroupID
    * text => any
}

; ---- #loglevel-events-def: LogLevelEventData and ProtocolEventData extension
LogLevelEventData = LogLevelError /
                    LogLevelWarning /
                    LogLevelInfo /
                    LogLevelDebug /
                    LogLevelVerbose

$ProtocolEventData /= LogLevelEventData

; ---- #loglevel-error-def: LogLevelError definition
LogLevelError = {
    ? code: uint64
    ? message: text

    * $$loglevel-error-extension
}

; ---- #loglevel-warning-def: LogLevelWarning definition
LogLevelWarning = {
    ? code: uint64
    ? message: text

    * $$loglevel-warning-extension
}

; ---- #loglevel-info-def: LogLevelInfo definition
LogLevelInfo = {
    message: text

    * $$loglevel-info-extension
}

; ---- #loglevel-debug-def: LogLevelDebug definition
LogLevelDebug = {
    message: text

    * $$loglevel-debug-extension
}

; ---- #loglevel-verbose-def: LogLevelVerbose definition
LogLevelVerbose = {
    message: text

    * $$loglevel-verbose-extension
}

; ---- #sim-events-def: SimulationEventData and ProtocolEventData extension
SimulationEventData = SimulationScenario /
                SimulationMarker

$ProtocolEventData /= SimulationEventData

; ---- #simulation-scenario-def: SimulationScenario definition
SimulationScenario = {
    ? name: text
    ? details: {* text => any }

    * $$simulation-scenario-extension
}

; ---- #simulation-marker-def: SimulationMarker definition
SimulationMarker = {
    ? type: text
    ? message: text

    * $$simulation-marker-extension
}

; ---- #raw-info-def: RawInfo definition
RawInfo = {

    ; the full byte length of the entity (e.g., packet or frame),
    ; including possible headers and trailers
    ? length: uint64

    ; the byte length of the entity's payload,
    ; excluding possible headers or trailers
    ? payload_length: uint64

    ; the (potentially truncated) contents of the full entity,
    ; including headers and possibly trailers
    ? data: hexstring
}
