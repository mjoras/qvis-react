+func TestConnIDManagerActiveConnIDChangeCallback(t *testing.T) {
+	type change struct{ old, new protocol.ConnectionID }
+	var changes []change
+	m := newConnIDManager(
+		protocol.ParseConnectionID([]byte{1, 2, 3, 4}),
+		func(protocol.StatelessResetToken) {},
+		func(protocol.StatelessResetToken) {},
+		func(wire.Frame) {},
+	)
+	m.onActiveConnIDChange = func(old, new protocol.ConnectionID) { changes = append(changes, change{old, new}) }
+
+	m.ChangeInitialConnID(protocol.ParseConnectionID([]byte{1, 2, 3, 4})) // unchanged
+	require.Empty(t, changes)
+	m.ChangeInitialConnID(protocol.ParseConnectionID([]byte{5, 6, 7, 8}))
+	require.Equal(t, []change{{
+		protocol.ParseConnectionID([]byte{1, 2, 3, 4}),
+		protocol.ParseConnectionID([]byte{5, 6, 7, 8}),
+	}}, changes)
+
+	require.NoError(t, m.Add(&wire.NewConnectionIDFrame{
+		SequenceNumber: 1,
+		ConnectionID:   protocol.ParseConnectionID([]byte{0xde, 0xad, 0xbe, 0xef}),
+	}))
+	m.SetHandshakeComplete()
+	require.Equal(t, protocol.ParseConnectionID([]byte{0xde, 0xad, 0xbe, 0xef}), m.Get())
+	require.Len(t, changes, 2)
+	require.Equal(t, change{
+		protocol.ParseConnectionID([]byte{5, 6, 7, 8}),
+		protocol.ParseConnectionID([]byte{0xde, 0xad, 0xbe, 0xef}),
+	}, changes[1])
+}
