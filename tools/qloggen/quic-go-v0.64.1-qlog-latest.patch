+// qlogSettingsFrame returns the qlog representation of a serialized SETTINGS frame, as well as its length.
+// The serialized frame is parsed (instead of using the fields of the settingsFrame),
+// such that settings are logged in the order they're sent on the wire.
+func qlogSettingsFrame(b []byte) (qlog.SettingsFrame, qlog.RawInfo) {
+	r := bytes.NewReader(b)
+	if _, err := quicvarint.Read(r); err != nil { // frame type
+		return qlog.SettingsFrame{}, qlog.RawInfo{}
+	}
+	l, err := quicvarint.Read(r)
+	if err != nil || l != uint64(r.Len()) {
+		return qlog.SettingsFrame{}, qlog.RawInfo{}
+	}
+	var settings []qlog.Setting
+	for r.Len() > 0 {
+		id, err := quicvarint.Read(r)
+		if err != nil {
+			break
+		}
+		val, err := quicvarint.Read(r)
+		if err != nil {
+			break
+		}
+		settings = append(settings, qlog.Setting{Identifier: id, Value: val})
+	}
+	return qlog.SettingsFrame{Settings: settings}, qlog.RawInfo{Length: len(b), PayloadLength: int(l)}
+}
