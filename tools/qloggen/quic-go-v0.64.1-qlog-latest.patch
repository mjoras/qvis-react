+		n, err = (&readerWithTimeout{Reader: str, Timeout: time.Second}).Read(make([]byte, 10))
+		require.ErrorIs(t, err, io.EOF)
+		require.Equal(t, 5, n)
+		// reading again doesn't log anything
+		n, err = (&readerWithTimeout{Reader: str, Timeout: time.Second}).Read(make([]byte, 10))
+		require.ErrorIs(t, err, io.EOF)
+		require.Zero(t, n)
+
+		require.Equal(t, []qlogwriter.Event{
+			qlog.StreamDataMoved{StreamID: 42, Offset: 0, Length: 4, From: qlog.DataLocationTransport, To: qlog.DataLocationApplication},
+			qlog.StreamDataMoved{StreamID: 42, Offset: 4, Length: 5, From: qlog.DataLocationTransport, To: qlog.DataLocationApplication, AdditionalInfo: qlog.DataMovedFinSet},
+		}, eventRecorder.Events())
+	})
+
+	t.Run("stream reset", func(t *testing.T) {
+		mockCtrl := gomock.NewController(t)
+		mockSender := NewMockStreamSender(mockCtrl)
+		var eventRecorder events.Recorder
+		str := newReceiveStream(42, mockSender, newTestStreamFlowController(42))
+		str.qlogger = &eventRecorder
+
+		mockSender.EXPECT().onStreamCompleted(protocol.StreamID(42))
+		require.NoError(t, str.handleResetStreamFrame(&wire.ResetStreamFrame{StreamID: 42, ErrorCode: 1234, FinalSize: 6}, monotime.Now()))
+		n, err := (&readerWithTimeout{Reader: str, Timeout: time.Second}).Read(make([]byte, 10))
+		require.Zero(t, n)
+		require.ErrorIs(t, err, &StreamError{StreamID: 42, ErrorCode: 1234, Remote: true})
+		require.Equal(t, []qlogwriter.Event{
+			qlog.StreamDataMoved{StreamID: 42, From: qlog.DataLocationTransport, To: qlog.DataLocationApplication, AdditionalInfo: qlog.DataMovedStreamReset},
+		}, eventRecorder.Events())
+	})
+}
