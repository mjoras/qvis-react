+// readPushID reads the push ID at the start of the payload of a CANCEL_PUSH, PUSH_PROMISE or MAX_PUSH_ID frame,
+// for logging the frame to qlog. It doesn't read beyond the frame payload of length l.
+// If the payload doesn't start with a push ID, ok is false.
+func readPushID(r *countingByteReader, l uint64) (pushID uint64, ok bool, _ error) {
+	if l == 0 {
+		return 0, false, nil
+	}
+	first, err := r.ReadByte()
+	if err != nil {
+		return 0, false, err
+	}
+	n := 1 << (first >> 6) // length of the varint
+	if uint64(n) > l {
+		return 0, false, nil
