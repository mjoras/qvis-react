+func TestConnectionLoggingSentFramesPadding(t *testing.T) {
+	ack := &wire.AckFrame{AckRanges: []wire.AckRange{{Smallest: 1, Largest: 3}}}
+	ping := &wire.PingFrame{}
+	sf := &wire.StreamFrame{StreamID: 4, Offset: 10, Data: []byte("foobar"), DataLenPresent: true}
+	framesLen := int(ack.Length(protocol.Version1) + ping.Length(protocol.Version1) + sf.Length(protocol.Version1))
+	frames := []ackhandler.Frame{{Frame: ping}}
+	streamFrames := []ackhandler.StreamFrame{{Frame: sf}}
+
+	// no padding
+	fs := qlogSentFrames(ack, frames, streamFrames, framesLen, protocol.Version1)
+	require.Equal(t, []qlog.Frame{
+		{Frame: toQlogAckFrame(ack)},
+		{Frame: ping},
+		{Frame: &qlog.StreamFrame{StreamID: 4, Offset: 10, Length: 6}},
+	}, fs)
+
+	// The padding is serialized after the ACK frame, see packetPacker.appendPacketPayload.
+	fs = qlogSentFrames(ack, frames, streamFrames, framesLen+42, protocol.Version1)
+	require.Equal(t, []qlog.Frame{
+		{Frame: toQlogAckFrame(ack)},
+		{Frame: &qlog.PaddingFrame{NumFrames: 42}},
+		{Frame: ping},
+		{Frame: &qlog.StreamFrame{StreamID: 4, Offset: 10, Length: 6}},
+	}, fs)
+
+	// without an ACK frame, the padding comes first
+	fs = qlogSentFrames(nil, frames, nil, int(ping.Length(protocol.Version1))+1000, protocol.Version1)
+	require.Equal(t, []qlog.Frame{
+		{Frame: &qlog.PaddingFrame{NumFrames: 1000}},
+		{Frame: ping},
+	}, fs)
+}
+
+func TestConnectionLoggingParseFrames(t *testing.T) {
+	c := &Conn{frameParser: *wire.NewFrameParser(false, false, false), version: protocol.Version1}
+
+	ack := &wire.AckFrame{AckRanges: []wire.AckRange{{Smallest: 5, Largest: 7}, {Smallest: 1, Largest: 2}}}
+	b, err := ack.Append(nil, protocol.Version1)
+	require.NoError(t, err)
+	b = append(b, 0, 0, 0) // 3 PADDING frames
+	b, err = (&wire.PingFrame{}).Append(b, protocol.Version1)
+	require.NoError(t, err)
+	b = append(b, 0) // 1 PADDING frame
+	b, err = (&wire.StreamFrame{StreamID: 4, Offset: 10, Data: []byte("foobar"), DataLenPresent: true}).Append(b, protocol.Version1)
+	require.NoError(t, err)
+	b = append(b, 0, 0) // 2 trailing PADDING frames
+
+	frames, err := c.qlogParseFrames(b, protocol.Encryption1RTT)
+	require.NoError(t, err)
+	// All PADDING frames are logged as a single PaddingFrame, at the position of the first PADDING frame.
+	require.Equal(t, []qlog.Frame{
+		{Frame: toQlogAckFrame(ack)},
+		{Frame: &qlog.PaddingFrame{NumFrames: 6}},
+		{Frame: &qlog.PingFrame{}},
+		{Frame: &qlog.StreamFrame{StreamID: 4, Offset: 10, Length: 6}},
+	}, frames)
+
+	// a payload that only consists of PADDING frames
+	frames, err = c.qlogParseFrames(make([]byte, 20), protocol.Encryption1RTT)
+	require.NoError(t, err)
+	require.Equal(t, []qlog.Frame{{Frame: &qlog.PaddingFrame{NumFrames: 20}}}, frames)
+
+	// invalid frames
+	_, err = c.qlogParseFrames([]byte{0x1f}, protocol.Encryption1RTT) // HANDSHAKE_DONE is 0x1e, 0x1f is not defined
+	require.Error(t, err)
+}
+
+func TestConnectionLoggingConnIDTracker(t *testing.T) {
+	c1 := protocol.ParseConnectionID([]byte{1, 1, 1, 1})
+	c2 := protocol.ParseConnectionID([]byte{2, 2, 2, 2})
+	c3 := protocol.ParseConnectionID([]byte{3, 3, 3, 3})
+	var tr qlogConnIDTracker
+	// the first connection ID is not an update
+	_, changed := tr.update(c1)
+	require.False(t, changed)
+	_, changed = tr.update(c1)
+	require.False(t, changed)
+	old, changed := tr.update(c2)
+	require.True(t, changed)
+	require.Equal(t, c1, old)
+	// a reordered packet using the previous connection ID is not an update
+	_, changed = tr.update(c1)
+	require.False(t, changed)
+	_, changed = tr.update(c2)
+	require.False(t, changed)
+	old, changed = tr.update(c3)
+	require.True(t, changed)
+	require.Equal(t, c2, old)
+}
+
+func TestConnectionLoggingIsProbingPacket(t *testing.T) {
+	require.True(t, qlogIsProbingPacket([]qlog.Frame{
+		{Frame: &qlog.PathChallengeFrame{}},
+		{Frame: &qlog.PaddingFrame{NumFrames: 10}},
+	}))
+	require.True(t, qlogIsProbingPacket([]qlog.Frame{
+		{Frame: &qlog.PathResponseFrame{}},
+		{Frame: &qlog.NewConnectionIDFrame{}},
+	}))
+	require.False(t, qlogIsProbingPacket([]qlog.Frame{
+		{Frame: &qlog.PathChallengeFrame{}},
+		{Frame: &qlog.PingFrame{}},
+	}))
+	require.False(t, qlogIsProbingPacket([]qlog.Frame{{Frame: &qlog.StreamFrame{}}}))
+}
