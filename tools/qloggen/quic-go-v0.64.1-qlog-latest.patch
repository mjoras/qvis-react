index 56df460..e428b3c 100644
--- a/connection_logging.go
+++ b/connection_logging.go
@@ -1,15 +1,197 @@
 package quic
 
 import (
+	"io"
 	"net"
 	"net/netip"
 	"slices"
 
+	"github.com/quic-go/quic-go/internal/ackhandler"
 	"github.com/quic-go/quic-go/internal/protocol"
 	"github.com/quic-go/quic-go/internal/wire"
 	"github.com/quic-go/quic-go/qlog"
+	"github.com/quic-go/quic-go/quicvarint"
 )
 
+// qlogAEADTagLength is the length of the AEAD tag, which qlog regards as a packet trailer
+// with a fixed size of 16 bytes (Section 1.2 of draft-ietf-quic-qlog-quic-events-13).
+const qlogAEADTagLength = 16
+
+// qlogPayloadLength calculates the length of a QUIC packet's payload,
+// excluding the header (including the packet number) and the AEAD tag.
+func qlogPayloadLength(lengthAfterHeader protocol.ByteCount) int {
+	return max(int(lengthAfterHeader)-qlogAEADTagLength, 0)
+}
+
+// qlogConnIDTracker tracks which of its connection IDs the peer currently uses,
+// for logging quic:connection_id_updated events.
+// A change is only reported the first time a connection ID is used, such that
+// reordered packets and packets sent on a different path don't cause spurious updates.
+type qlogConnIDTracker struct {
+	current    protocol.ConnectionID
+	hasCurrent bool
+	seen       []protocol.ConnectionID
+}
+
+// update returns the previously used connection ID if connID is now in use for the first time.
+func (t *qlogConnIDTracker) update(connID protocol.ConnectionID) (old protocol.ConnectionID, changed bool) {
+	if t.hasCurrent && t.current == connID {
+		return protocol.ConnectionID{}, false
+	}
+	if slices.Contains(t.seen, connID) {
+		return protocol.ConnectionID{}, false
+	}
+	t.seen = append(t.seen, connID)
+	old, hadCurrent := t.current, t.hasCurrent
+	t.current, t.hasCurrent = connID, true
+	return old, hadCurrent
+}
+
+// qlogActiveConnIDChanged logs a quic:connection_id_updated event (initiator "remote")
+// when this endpoint changes the Destination Connection ID it uses on the active path:
+// the client switching to the server's Source Connection ID during the handshake (or after a Retry),
+// and switching to a connection ID issued in a NEW_CONNECTION_ID frame.
+func (c *Conn) qlogActiveConnIDChanged(old, new protocol.ConnectionID) {
+	c.qlogger.RecordEvent(qlog.ConnectionIDUpdated{Initiator: qlog.InitiatorRemote, Old: &old, New: &new})
+}
+
+// qlogReceivedDestConnID logs a quic:connection_id_updated event (initiator "local")
+// when the peer starts using a new connection ID issued by this endpoint.
+// Probing packets (Section 9.1 of RFC 9000) are ignored.
+func (c *Conn) qlogReceivedDestConnID(connID protocol.ConnectionID, frames []qlog.Frame) {
+	if qlogIsProbingPacket(frames) {
+		return
+	}
+	if old, changed := c.qlogLocalConnIDs.update(connID); changed {
+		c.qlogger.RecordEvent(qlog.ConnectionIDUpdated{Initiator: qlog.InitiatorLocal, Old: &old, New: &connID})
+	}
+}
+
+// qlogIsProbingPacket says if a packet only contains probing frames,
+// i.e. PATH_CHALLENGE, PATH_RESPONSE, NEW_CONNECTION_ID and PADDING frames.
+func qlogIsProbingPacket(frames []qlog.Frame) bool {
+	for _, f := range frames {
+		switch f.Frame.(type) {
+		case *qlog.PathChallengeFrame, *qlog.PathResponseFrame, *qlog.NewConnectionIDFrame, *qlog.PaddingFrame:
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// qlogSentFrames converts the frames of a packet that is sent to qlog frames.
+// The frames are listed in the order in which they are serialized by the packet packer:
+// the ACK frame, the PADDING frames, the control frames, and finally the STREAM frames
+// (see packetPacker.appendPacketPayload).
+// The PADDING frames are not tracked by the packer explicitly: they make up the remainder of
+// the payload, i.e. payloadLen minus the length of all other frames. They are logged as a single
+// PaddingFrame (Section 8.13.1 of draft-ietf-quic-qlog-quic-events-13).
+func qlogSentFrames(
+	ack *wire.AckFrame,
+	frames []ackhandler.Frame,
+	streamFrames []ackhandler.StreamFrame,
+	payloadLen int,
+	v protocol.Version,
+) []qlog.Frame {
+	numFrames := len(frames) + len(streamFrames) + 1 // +1 for PADDING
+	if ack != nil {
+		numFrames++
+	}
+	fs := make([]qlog.Frame, 0, numFrames)
+	var framesLen protocol.ByteCount
+	if ack != nil {
+		fs = append(fs, toQlogFrame(ack))
+		framesLen += ack.Length(v)
+	}
+	paddingIdx := len(fs)
+	for _, f := range frames {
+		fs = append(fs, toQlogFrame(f.Frame))
+		framesLen += f.Frame.Length(v)
+	}
+	for _, f := range streamFrames {
+		fs = append(fs, toQlogFrame(f.Frame))
+		framesLen += f.Frame.Length(v)
+	}
+	if padding := payloadLen - int(framesLen); padding > 0 {
+		fs = slices.Insert(fs, paddingIdx, qlog.Frame{Frame: &qlog.PaddingFrame{NumFrames: int64(padding)}})
+	}
+	return fs
+}
+
+// qlogParseFrames parses the frames of a received packet, without handling them.
+// This allows logging the packet_received event before handling the frames,
+// such that the event precedes all events caused by processing the packet
+// (e.g. recovery_metrics_updated, packet_lost or key_discarded).
+// PADDING frames are logged as a single PaddingFrame, at the position of the first PADDING frame
+// (Section 8.13.1 of draft-ietf-quic-qlog-quic-events-13).
+func (c *Conn) qlogParseFrames(data []byte, encLevel protocol.EncryptionLevel) ([]qlog.Frame, error) {
+	frames := make([]qlog.Frame, 0, 4)
+	paddingIdx := -1
+	var numPadding int64
+	addPadding := func(n int) {
+		if n <= 0 {
+			return
+		}
+		if paddingIdx < 0 {
+			paddingIdx = len(frames)
+			frames = append(frames, qlog.Frame{}) // placeholder, set below
+		}
+		numPadding += int64(n)
+	}
+	for len(data) > 0 {
+		frameType, l, err := c.frameParser.ParseType(data, encLevel)
+		if err != nil {
+			// The frame parser skips over PADDING frames, and returns an io.EOF if the PADDING
+			// frames were the last frames in this packet.
+			if err == io.EOF {
+				addPadding(l)
+				break
+			}
+			return nil, err
+		}
+		// ParseType skips over PADDING frames (single 0x00 bytes) preceding the frame.
+		addPadding(l - quicvarint.Len(uint64(frameType)))
+		data = data[l:]
+
+		switch {
+		case frameType.IsStreamFrameType():
+			f, n, err := c.frameParser.ParseStreamFrame(frameType, data, c.version)
+			if err != nil {
+				return nil, err
+			}
+			data = data[n:]
+			frames = append(frames, toQlogFrame(f))
+			f.PutBack()
+		case frameType.IsAckFrameType():
+			f, n, err := c.frameParser.ParseAckFrame(frameType, data, encLevel, c.version)
+			if err != nil {
+				return nil, err
+			}
+			data = data[n:]
+			frames = append(frames, toQlogFrame(f)) // copies the (reused) ACK frame
+		case frameType.IsDatagramFrameType():
+			f, n, err := c.frameParser.ParseDatagramFrame(frameType, data, c.version)
+			if err != nil {
+				return nil, err
+			}
+			data = data[n:]
+			frames = append(frames, toQlogFrame(f))
+		default:
+			f, n, err := c.frameParser.ParseLessCommonFrame(frameType, data, c.version)
+			if err != nil {
+				return nil, err
+			}
+			data = data[n:]
+			frames = append(frames, toQlogFrame(f))
+		}
+	}
+	if paddingIdx >= 0 {
+		frames[paddingIdx] = qlog.Frame{Frame: &qlog.PaddingFrame{NumFrames: numPadding}}
+	}
+	return frames, nil
+}
