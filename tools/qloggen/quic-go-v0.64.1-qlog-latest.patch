+	b := make([]byte, n)
+	b[0] = first
+	if _, err := io.ReadFull(r, b[1:]); err != nil {
+		if err == io.ErrUnexpectedEOF {
+			return 0, false, io.EOF
+		}
+		return 0, false, err
+	}
+	pushID, _, err = quicvarint.Parse(b)
+	if err != nil {
+		return 0, false, nil
+	}
+	return pushID, true, nil
